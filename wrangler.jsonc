{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sin-prisa-pero-con-alma",
  "pages_build_output_dir": "./dist-public",
  "compatibility_date": "2026-08-29",
  "vars": {
    "ORDER_INTAKE_URL": "https://pedidos-sinprisa.isivoltpro.com/api/sinprisa/order-requests"
  },
  "secrets": {
    "required": [
      "CF_ACCESS_CLIENT_ID",
      "CF_ACCESS_CLIENT_SECRET",
      "ORDER_INTAKE_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
